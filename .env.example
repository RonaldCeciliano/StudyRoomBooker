# Copy to .env on the server and replace every value. FAKE EXAMPLES ONLY; never commit .env.
SITE_ADDRESS=studyroombooker.example.duckdns.org
APP_BASE_URL=https://studyroombooker.example.duckdns.org
DB_USERNAME=studyroombooker
DB_PASSWORD=change-me-long-random-password
SMTP_USERNAME=studyroombooker.example@gmail.com
SMTP_PASSWORD=abcd-efgh-ijkl-mnop
EMAIL_FROM=studyroombooker.example@gmail.com
# Optional: where daily database dumps are written on the host, and how many days to keep.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Optional off-box backup copy (docs/deployment.md "Off-box copy"). Uncomment all of these
# to enable the offsite service. Oracle: Object Storage > bucket; keys are "Customer secret keys".
# COMPOSE_PROFILES=offsite
# OFFSITE_ENDPOINT=https://examplenamespace.compat.objectstorage.us-ashburn-1.oraclecloud.com
# OFFSITE_REGION=us-ashburn-1
# OFFSITE_BUCKET=studyroombooker-backups
# OFFSITE_ACCESS_KEY_ID=0123456789abcdef0123456789abcdef01234567
# OFFSITE_SECRET_ACCESS_KEY=example-secret-key
# OFFSITE_RETENTION_DAYS=30
